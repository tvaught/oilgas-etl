[Unit]
Description=Oil & Gas Reporting application
After=network.target

[Service]
Type=simple
User=oilgas
Group=oilgas
WorkingDirectory=/srv/oilgas/app
EnvironmentFile=/etc/oilgas.env
ExecStart=/srv/oilgas/app/.venv/bin/gunicorn \
    --workers 1 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    'oilgas.web:create_app()'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
