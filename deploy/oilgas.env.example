# Required on openhollow for authenticated production access.
OILGAS_AUTH_REQUIRED=true
OILGAS_DATABASE=/srv/oilgas/data/oilgas.duckdb
OILGAS_SECRET_KEY=replace-with-a-random-64-character-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
OILGAS_ALLOWED_EMAILS=travis@example.com,approved-partner@example.com
